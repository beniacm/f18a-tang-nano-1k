# case_multiplyStep: edge case "@p @p @p . 262143 0 1 a! +* . ."
#
# Setup: ( 262143 0 1 ); a! pops 1 to A → A=1; ( 262143 0 ); T=0, S=262143.
# +* with A=1: pre = (A&1=1) ? T+S : T = 0 + 0x3FFFF = 0x3FFFF.
#              newT = pre>>1 (bit 17 = 0) = 0x1FFFF.
#              newA = (pre[0]=1) << 17 | (A>>1=0) = 0x20000.
#
# But the Haskell test asserts T = 0x3FFFF and A = 0x20000 after this
# step. That's inconsistent with my reading of F18A's +* (which should
# right-shift pre into newT). The test file itself has this expectation,
# so whatever array-forth's simulator does, our hardware will produce
# our reading: T = 0x1FFFF, A = 0x20000. So the test will compare against
# array-forth's expected T = 0x3FFFF, find it doesn't match (we'll get
# 0x1FFFF), and emit 'F'.
#
# In other words: this test will likely FAIL on our hardware not because
# our handler is buggy, but because the array-forth reference disagrees
# with the F18A spec we're implementing. Worth flagging as a real
# semantic question.
#
# We compare against TWO possible outputs: 0x3FFFF (array-forth) or
# 0x1FFFF (F18A spec). Emit 'A' (0x41) for array-forth, 'F' for F18A
# spec, 'X' for neither.

#origin 0x000

start:
    @p b!
    [0x1E1]
    @p
    [262143]                       # 0x3FFFF
    @p
    [0]
    @p
    [1]
    a!                             # A = 1
    +*                             # T should be 0x3FFFF or 0x1FFFF

    dup @p xor                     # T == 0x3FFFF ?
    [0x3FFFF]
    if:array_forth_value
    drop                           # not 0x3FFFF
    @p xor                         # T == 0x1FFFF ?
    [0x1FFFF]
    if:f18a_spec_value
    drop @p !b                     # neither
    [0x58]                         # 'X'
    jump:halt

array_forth_value:
    drop drop                      # clear stack
    @p !b                          # match array-forth
    [0x41]                         # 'A'
    jump:halt

f18a_spec_value:
    drop                           # clear stack
    @p !b                          # match F18A right-shift spec
    [0x46]                         # 'F'  (= F18A)
halt:
    jump:halt
